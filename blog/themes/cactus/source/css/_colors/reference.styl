$color-link = rgba(120, 140, 255, 1)
$color-text = #d0d0e8
$color-accent-3 = #555
$color-accent-2 = #8899ff
$color-accent-1 = #7c5ce7
$color-quote = #7c5ce7
$highlight = hexo-config("highlight") || "rainbow"
