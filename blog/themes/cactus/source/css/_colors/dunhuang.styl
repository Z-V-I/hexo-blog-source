// 敦煌配色 - 翡翠绿 + 朱砂红 + 暖杏白 - 浅棕底色
$color-background = #2a2018  // 浅褐色底
$color-footer-mobile-1 = lighten($color-background, 2%)
$color-footer-mobile-2 = lighten($color-background, 12%)
$color-background-code = lighten($color-background, 4%)
$color-border = #5a4a38
$color-scrollbar = #7a6a58
$color-meta = #c0b098
$color-meta-code = #d0c0a8
$color-link = #3ca081  // 翡翠绿
$color-text = #f5deb2  // 暖杏白文字
$color-accent-3 = #9a8a78
$color-accent-2 = #b1302b  // 朱砂红
$color-accent-1 = #3ca081  // 翡翠绿主色
$color-quote = #b1302b
$highlight = hexo-config("highlight") || "rainbow"
