@import "_variables"
@import "_colors/" + $colors
@import "_util"
@import "_mixins"
@import "_extend"
@import "_fonts"

global-reset()

*, *:before, *:after
  box-sizing: border-box

/* Scroll bar */
/* For Firefox */
*
  scrollbar-color: $color-scrollbar transparent

/* For Chrome, Edge, and Safari */
*::-webkit-scrollbar
  width: 8px
  height: 6px

*::-webkit-scrollbar-track
  background: transparent

*::-webkit-scrollbar-thumb
  background-color: $color-scrollbar
  border-radius: 6px

*::-webkit-scrollbar-thumb:hover
  background-color: darken($color-scrollbar, 20%)

*::-webkit-scrollbar-thumb:active
  background-color: darken($color-scrollbar, 30%)

html
  margin: 0
  padding: 0
  height: 100%
  border-top: 2px solid $color-text
  -webkit-text-size-adjust: 100%
  -ms-text-size-adjust: 100%

body
  margin: 0
  height: 100%
  background-color: $color-background
  color: $color-text
  font-weight: 400
  font-size: $font-size
  font-family: $font-family-body
  line-height: $line-height
  text-rendering: geometricPrecision

  antialias()

  @extend $base-style

.content
  position: relative
  display: flex
  flex-direction: column
  min-height: 100%
  overflow-wrap: break-word

  p
    hyphens(auto)

  code
    hyphens(manual)

  a
    color: $color-text
    text-decoration: none

    underline(5px, $color-text)

    &:hover
      background-image: linear-gradient(transparent, transparent 4px, $color-link 4px, $color-link)

  a.icon
    background: none

    &:hover
      color: $color-link

  h1 a, .h1 a, h2 a, h3 a, h4 a, h5 a, h6 a
    background: none
    color: inherit
    text-decoration: none

  h1 a:hover, .h1 a:hover, h2 a:hover, h3 a:hover, h4 a:hover, h5 a:hover, h6 a:hover
    underline(6px, $color-link)

  h6
    a
      background: none
      color: inherit
      text-decoration: none

  h6
    a:hover
      underline(6px, $color-link)

@media (min-width: 540px)
  .image-wrap
    flex-direction: row
    margin-bottom: 2rem

    .image-block
      flex: 1 0 35%
      margin-right: 2rem

    p
      flex: 1 0 65%

.max-width
  max-width: $page-width

@media (max-width: 480px)
  // smaller margins at smaller screen widths
  .px3
    padding-right: 1rem
    padding-left: 1rem

  .my4
    margin-top: 2rem
    margin-bottom: 2rem

@media (min-width: 480px)
  p
    text-align: justify

@import "_partial/header"
@import "_partial/post/actions_desktop"
@import "_partial/post/actions_mobile"
@import "_partial/index"
@import "_partial/article"
@import "_partial/archive"
@import "_partial/comments"
@import "_partial/footer"
@import "_partial/pagination"
@import "_partial/search"
@import "_partial/tags"
@import "_partial/tooltip"
@import "_partial/categories"
// Code
@import "_highlight/" + $highlight

pre
  overflow-x: auto
  padding: 10px 15px
  padding-bottom: 0
  border: 1px dotted $color-border
  border-radius: 4px
  font-size: 13px
  font-family: $font-family-mono
  line-height: 22px
  -webkit-border-radius: 4px

  code
    display: block
    padding: 0
    border: none

code
  padding: 0 5px
  border: 1px dotted $color-border
  border-radius: 2px
  -webkit-border-radius: 2px

.highlight
  overflow-x: auto
  margin: 1rem 0
  padding: 10px 15px
  border-radius: 4px
  background: $color-background-code
  font-family: $font-family-mono
  // color: $color-accent-3
  -webkit-border-radius: 4px

  figcaption
    margin: -5px 0 5px
    color: $color-meta-code
    font-size: .9em
    transform: scale(1)

    a
      float: right
      color: $color-meta-code
      font-style: italic
      font-size: .8em

      underline(10px, $color-link)

    a:hover
      color: lighten($color-meta-code, 20%)

    &:before, content: ""
      display: table

    &:after
      clear: both

  &:hover 
    .btn-copy
      opacity: 1

  .btn-copy
    font-size: 1.2rem
    position: absolute
    right: 20px
    opacity: 0
    transition: opacity 0.2s ease-in
    &:hover
      color: $color-accent-1

  pre
    margin: 0
    padding: 0
    border: none
    background: none

  table
    width: auto

  td.gutter
    text-align: right
    opacity: .2

  .line
    height: 22px

#header-post #actions
  direction: ltr !important

/* 文章返回键 */
.post-back
  display: inline-flex
  align-items: center
  gap: 6px
  padding: 8px 16px
  margin-bottom: 16px
  border-radius: 6px
  font-size: 14px
  text-decoration: none
  background: rgba(128,128,128,0.1)
  color: $color-text
  transition: background 0.2s
  i
    font-size: 13px
.post-back:hover
  background: rgba(128,128,128,0.2)

/* 标题无下划线 */
#title h1 a, #title .h1 a
  background: none !important
  text-decoration: none !important

/* 左上角配色切换 */
.scheme-switch-top
  position: fixed
  top: 14px
  left: 14px
  z-index: 1001
.scheme-label-top
  display: inline-flex
  align-items: center
  gap: 5px
  padding: 4px 10px
  border-radius: 16px
  font-size: 11px
  cursor: pointer
  background: rgba(100,100,100,0.12)
  backdrop-filter: blur(8px)
  border: 1px solid rgba(120,120,120,0.2)
  color: $color-text
  transition: all 0.2s
.scheme-label-top:hover
  background: rgba(100,100,100,0.22)
  border-color: rgba(150,150,150,0.35)
.scheme-label-top i
  font-size: 11px
  opacity: 0.65
.scheme-select-top
  background: transparent
  border: none
  color: $color-text
  padding: 2px
  font-size: 11px
  cursor: pointer
  outline: none
  font-family: inherit
  option
    background: $color-background
    color: $color-text

/* Footer 紧凑居中（与评论区拉开间距，避免重叠） */
#footer
  text-align: center
  padding: 32px 0 24px
  border-top: 1px solid $color-border
  margin-top: 56px
  width: 100%
  position: relative
  z-index: 1
  background: $color-background
.footer-cr
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Microsoft YaHei", sans-serif
  font-size: 12px
  color: $color-meta
  line-height: 1.5
  letter-spacing: 0.2px
  text-align: center
.footer-powered
  font-size: 11px
  color: $color-meta
  margin-top: 4px
  line-height: 1.6
  text-align: center
  a
    color: $color-link
.footer-version
  font-size: 10px
  color: rgba(128,128,128,0.7)
  margin-top: 10px
  text-align: center
  letter-spacing: 0.5px
  user-select: none



/* 内容居中约束 */
.content
  max-width: 48rem
  margin: 0 auto
  width: 100%

/* 分类标题图标 */
.cat-icon
  margin-right: 6px
  font-size: 0.9em

/* 社交弹窗 */
.contact-overlay
  position: fixed
  inset: 0
  background: rgba(0,0,0,0.5)
  display: flex
  align-items: center
  justify-content: center
  z-index: 1000
  backdrop-filter: blur(4px)
.contact-card
  background: $color-background
  border: 1px solid $color-border
  border-radius: 16px
  padding: 32px 28px
  min-width: 320px
  box-shadow: 0 8px 32px rgba(0,0,0,0.3)
  text-align: center
  h3
    font-size: 18px
    margin-bottom: 20px
    color: $color-text
.contact-item
  display: flex
  align-items: center
  gap: 12px
  padding: 14px 16px
  margin-bottom: 10px
  border-radius: 10px
  cursor: pointer
  transition: background 0.15s
  background: rgba(128,128,128,0.06)
  i
    font-size: 18px
    color: $color-link
    width: 24px
    text-align: center
  .contact-val
    flex: 1
    text-align: left
    font-size: 14px
    color: $color-text
    font-family: "SF Mono", "Menlo", monospace
  .contact-copy
    font-size: 12px
    padding: 4px 10px
    border-radius: 6px
    background: $color-link
    color: #fff
    white-space: nowrap
.contact-item:hover
  background: rgba(128,128,128,0.12)
.btn-close-contact
  margin-top: 14px
  padding: 8px 24px
  border: 1px solid $color-border
  border-radius: 8px
  background: transparent
  color: $color-meta
  font-size: 13px
  cursor: pointer
  font-family: inherit
  transition: all 0.15s
.btn-close-contact:hover
  color: $color-text
  border-color: $color-text

/* 移动端导航紧凑 */
#header
  flex-wrap: wrap


/* ========== 精选 / 加密 / 分类标签 ========== */
.featured-tag
  display: inline-block
  margin-left: 8px
  padding: 1px 8px
  font-size: 11px
  line-height: 1.6
  border-radius: 10px
  background: rgba(255, 193, 7, 0.18)
  color: #e8b84b
  border: 1px solid rgba(255, 193, 7, 0.4)
  vertical-align: middle
  white-space: nowrap

.locked-tag
  display: inline-block
  margin-left: 8px
  padding: 1px 8px
  font-size: 11px
  line-height: 1.6
  border-radius: 10px
  background: rgba(158, 158, 158, 0.18)
  color: $color-meta
  border: 1px solid rgba(158, 158, 158, 0.4)
  vertical-align: middle
  white-space: nowrap

.post-lock
  margin-left: 6px
  color: $color-meta
  font-size: 13px

.featured-icon
  margin-left: 8px
  color: #e8b84b
  font-size: 13px
  vertical-align: middle

/* 出处板块小标签（与后台同色系） */
.cat-tag
  display: inline-block
  margin-left: 8px
  padding: 1px 8px
  font-size: 11px
  line-height: 1.6
  border-radius: 10px
  vertical-align: middle
  white-space: nowrap
  &.cat-project
    background: rgba(0, 122, 255, 0.15)
    color: #5ea8ff
    border: 1px solid rgba(0, 122, 255, 0.35)
  &.cat-life
    background: rgba(52, 199, 89, 0.15)
    color: #4cd964
    border: 1px solid rgba(52, 199, 89, 0.35)
  &.cat-research
    background: rgba(175, 82, 222, 0.15)
    color: #c77dff
    border: 1px solid rgba(175, 82, 222, 0.35)

/* ========== 加密门禁 ========== */
.post-lock-box
  max-width: 340px
  margin: 24px auto
  padding: 28px 24px
  text-align: center
  border: 1px dashed $color-border
  border-radius: 12px
  background: $color-background-code
.post-lock-icon
  font-size: 32px
  color: $color-meta
  margin-bottom: 10px
.post-lock-title
  font-size: 16px
  font-weight: 600
  color: $color-text
  margin-bottom: 4px
.post-lock-hint
  font-size: 13px
  color: $color-meta
  margin-bottom: 16px
.post-lock-input-row
  display: flex
  gap: 8px
  justify-content: center
  input
    width: 160px
    padding: 8px 12px
    border: 1px solid $color-border
    border-radius: 8px
    background: $color-background
    color: $color-text
    font-size: 14px
    font-family: inherit
    outline: none
    &:focus
      border-color: $color-accent-1
  button
    padding: 8px 18px
    border: none
    border-radius: 8px
    background: $color-accent-1
    color: #fff
    font-size: 14px
    cursor: pointer
    font-family: inherit
    &:hover
      opacity: 0.85
.post-lock-msg
  margin-top: 10px
  font-size: 13px
  min-height: 18px


/* 板块查看更多链接 */
.more-link
  display: inline-block
  margin-top: 6px
  font-size: 13px
  color: $color-link
  opacity: 0.85
  transition: all 0.15s
  &:hover
    opacity: 1
    color: $color-link
    text-decoration: underline
