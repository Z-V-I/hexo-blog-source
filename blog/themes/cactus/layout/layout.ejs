<!DOCTYPE html>
<html<%= config.language ? " lang=" + config.language.substring(0, 2) : ""%>>
<%- partial('_partial/head') %>
<body class="max-width mx-auto px3 <%- theme.direction -%>">
    <!-- 右上角配色切换 + 全屏控制 -->
    <div class="scheme-switch-top">
      <label for="color-scheme-switch" class="scheme-label-top">
        <i class="fa-solid fa-palette"></i>
        <select id="color-scheme-switch" class="scheme-select-top">
          <option value="dark">暗黑</option>
          <option value="classic">茉莉</option>
          <option value="cloudflare">云端</option>
          <option value="reference">紫霞</option>
          <option value="dunhuang">敦煌</option>
        </select>
      </label>
      <button type="button" id="btn-fs-enter" class="scheme-label-top" title="进入全屏" style="border:1px solid rgba(120,120,120,0.2);background:transparent;color:inherit;border-radius:8px;padding:2px 8px;font-size:12px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
        <i class="fa-solid fa-expand"></i><span>全屏</span>
      </button>
      <button type="button" id="btn-fs-exit" class="scheme-label-top" title="退出全屏" style="border:1px solid rgba(120,120,120,0.2);background:transparent;color:inherit;border-radius:8px;padding:2px 8px;font-size:12px;cursor:pointer;display:none;align-items:center;gap:4px">
        <i class="fa-solid fa-compress"></i><span>退出</span>
      </button>
    </div>
    <% if (is_post()) { %>
      <%- partial('_partial/post/actions_desktop') %>
    <% } %>
    <div class="content index py4 <%= is_home() ? 'h-card' : '' %>">
        <% if (!is_post()) { %>
          <%- partial('_partial/header') %>
        <% } %>
        <%- body %>
        <% if (is_post()) { %>
          <%- partial('_partial/post/actions_mobile') %>
        <% } %>
        <%- partial('_partial/footer') %>
    </div>
    <%- partial('_partial/styles') %>
    <%- partial('_partial/scripts') %>
</body>
</html>
